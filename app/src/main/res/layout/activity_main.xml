<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:text="自动跳过应用启动时的开屏广告"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 状态 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="@color/warn"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="需要手动开启无障碍权限，服务才能读取窗口并执行点击。"
                style="@style/Hint" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/open_accessibility" />
        </LinearLayout>

        <!-- 基本设置 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_basic" />

            <Switch
                android:id="@+id/swEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_skip"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_skip_desc"
                style="@style/Hint" />

            <TextView
                android:id="@+id/tvDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="点击延迟：300 ms"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sbDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2000"
                android:progress="300" />

            <TextView
                android:id="@+id/tvWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="启动后检测时长：6 秒"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sbWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="8"
                android:progress="4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="只在这段时间内工作，超过后不再点击，避免误触。"
                style="@style/Hint" />
        </LinearLayout>

        <!-- 兜底策略 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_strategy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/strategy_hint"
                style="@style/Hint" />

            <RadioGroup
                android:id="@+id/rgStrategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbStrategy0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strategy_element"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbStrategy1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strategy_tap"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbStrategy2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strategy_back"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 坐标位置 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_corner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/corner_hint"
                style="@style/Hint" />

            <RadioGroup
                android:id="@+id/rgCorner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbCorner0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/corner_tr"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbCorner1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/corner_br"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbCorner2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/corner_tl"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbCorner3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/corner_bl"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 生效范围 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_whitelist" />

            <EditText
                android:id="@+id/etWhitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/whitelist_label"
                android:inputType="text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/whitelist_hint"
                style="@style/Hint" />
        </LinearLayout>

        <!-- 日志 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_log" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/log_empty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:text="@string/footer_note"
            style="@style/Hint" />
    </LinearLayout>
</ScrollView>
